{
	"schemaVersion": 1,
	"id": "portalgun",
	"version": "${version}",
	"name": "Portal Gun",
	"description": "An animated Portal gun for Minecraft, ported from the Source engine viewmodel.",
	"authors": [
		"avrgknye"
	],
	"license": "All-Rights-Reserved",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.avrgknye.portalgun.PortalGunMod"
		],
		"client": [
			"com.avrgknye.portalgun.client.PortalGunClient"
		]
	},
	"mixins": [
		{
			"config": "portalgun.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.14.21",
		"minecraft": "1.20.1",
		"java": ">=17",
		"fabric-api": "*"
	}
}
